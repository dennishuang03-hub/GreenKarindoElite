# Copy this file to ".env.local" and fill in the values.
# .env.local is git-ignored, so the keys stay off GitHub.

# ── Supabase (contact-form lead capture) ─────────────────────────
# Dashboard -> Project Settings -> API. Use the PUBLISHABLE (anon) key
# only — it ends up in the browser bundle. The service-role key must
# never appear here.
# Leave both blank and the contact form still works: it falls back to
# handing the visitor a pre-filled WhatsApp message.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Sitemap (build time only) ────────────────────────────────────
# The site's own domain, used to write dist/sitemap.xml during
# `npm run build`. On Vercel, set this as a project environment
# variable instead. Without it the build skips the sitemap.
SITE_URL=
